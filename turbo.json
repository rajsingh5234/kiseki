{
   "$schema": "https://turborepo.dev/schema.json",
   "tasks": {
      "build": {
         "dependsOn": ["^build"],
         "outputs": ["dist/**"]
      },
      "typecheck": {
         "dependsOn": ["^transit"]
      },
      "test": {
         "dependsOn": ["^transit"],
         "outputs": ["coverage/**"]
      },
      "transit": {
         "dependsOn": ["^transit"]
      },
      "dev": {
         "persistent": true,
         "cache": false
      }
   }
}
