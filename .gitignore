# Dependencies (rebuilt by `pnpm install`)
node_modules/

# Build output and caches
dist/
.turbo/
*.tsbuildinfo

# Test reports
coverage/

# Secrets: never commit real env files; the example file is shared
.env
.env.*
!.env.example

# Logs
*.log

# OS clutter
.DS_Store

# Editor: share only the team settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
