{
   "$schema": "./node_modules/oxlint/configuration_schema.json",
   "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "vitest"],
   "categories": {
      "correctness": "error",
      "suspicious": "error",
      "perf": "warn"
   },
   "rules": {
      "import/no-relative-parent-imports": "error",
      "no-restricted-imports": [
         "error",
         {
            "patterns": [
               {
                  "group": ["#modules/*/**", "!#modules/*/index.ts"],
                  "message": "Import another module only through its public index.ts, e.g. #modules/health/index.ts."
               }
            ]
         }
      ]
   },
   "overrides": [
      {
         "files": ["**/*.ts"],
         "excludeFiles": ["**/*.test.ts", "**/*.fixture.ts"],
         "rules": {
            "no-restricted-imports": [
               "error",
               {
                  "patterns": [
                     {
                        "group": ["#modules/*/**", "!#modules/*/index.ts"],
                        "message": "Import another module only through its public index.ts, e.g. #modules/health/index.ts."
                     },
                     {
                        "group": ["**/*.fixture.ts"],
                        "message": "Fixtures are test-only: import them only from *.test.ts files."
                     }
                  ]
               }
            ]
         }
      }
   ],
   "options": {
      "typeAware": true
   }
}
