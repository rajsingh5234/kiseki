# Kiseki API environment variables.
# For local changes, copy this file: cp .env.example .env (.env is never committed).
# A blank value means "use the default".

# Where the app runs: development | test | production. Required.
# Set by the dev script, by Vitest and by the hosting platform, so it isn't set here.
# NODE_ENV=development

# Port the server listens on. Default: 3000.
PORT=3000

# Address the server listens on. Default: 127.0.0.1 (this computer only).
# Production sets 0.0.0.0 so the hosting platform can reach it.
HOST=127.0.0.1

# How much to log: fatal | error | warn | info | debug | trace | silent.
# Blank: chosen from NODE_ENV (debug in development, silent in tests, info in production).
LOG_LEVEL=
